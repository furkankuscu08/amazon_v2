# Source requirements for WorkBot.
# Compile to the lock file with:
#   uv pip compile requirements.in --python-version 3.12 -o requirements.txt
#
# --- Runtime ---
fastapi
uvicorn[standard]
jinja2
pydantic
httpx
boto3
# Voice input: Nova 2 Sonic needs Bedrock's bidirectional stream, which boto3
# does not offer; the duplex transport needs the awscrt extra.
aws-sdk-bedrock-runtime
smithy-http[awscrt]
qdrant-client
fastembed
python-dotenv

# --- Dev / tooling ---
pytest
ruff
