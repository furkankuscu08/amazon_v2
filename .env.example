# WorkBot local environment — copy to .env and fill in.
#   cp .env.example .env
# .env is git-ignored (see .gitignore); never commit real keys.

# --- Model provider ---
# bedrock (default) or openrouter (fallback).
WORKBOT_MODEL_PROVIDER=bedrock

# --- Amazon Bedrock (default LLM) ---
# No AWS keys here: run `aws configure --profile workbot` once, and boto3 reads
# that profile's credentials from ~/.aws/. Unset AWS_PROFILE on a server that
# uses an instance role. Never set AWS_BEARER_TOKEN_BEDROCK to an empty value.
AWS_PROFILE=workbot
AWS_REGION=eu-north-1
# Optional override of the cross-Region inference profile:
# WORKBOT_BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0

# --- OpenRouter (fallback LLM) ---
# Needed only with WORKBOT_MODEL_PROVIDER=openrouter.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Qdrant (vector store) ---
# Local Docker service started by compose.yaml.
QDRANT_URL=http://localhost:6333
# If host port 6333 is occupied, set both values to another port (e.g. 6335).
QDRANT_HOST_PORT=6333

# --- SQLite ---
# Default matches the app; change to relocate the local database.
WORKBOT_DB_PATH=data/workbot.sqlite3

# --- Local embeddings ---
# FastEmbed runs all-MiniLM-L6-v2 locally after the first model download.

# --- Docker / uvicorn ---
# Host port mapped to the app container (compose "app" profile); app itself listens on 8000.
WORKBOT_HOST_PORT=8000
